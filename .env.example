# === Obligatoire ===

# Token du bot — Developer Portal > ton application > Bot > "Reset Token"
DISCORD_TOKEN=colle-ton-token-ici

# ID de l'application — Developer Portal > General Information > Application ID
CLIENT_ID=

# ID de ton serveur — active le Mode développeur dans Discord,
# puis clic droit sur le serveur > "Copier l'identifiant du serveur"
GUILD_ID=

# === Optionnel ===

# Salon où poster les messages de bienvenue (sinon le salon système du serveur est utilisé)
WELCOME_CHANNEL_ID=

# Salon où poster les messages de départ (sinon = WELCOME_CHANNEL_ID, sinon salon système)
GOODBYE_CHANNEL_ID=

# Rôle donné automatiquement aux nouveaux arrivants (ex: "Gobelin")
AUTO_ROLE_ID=
